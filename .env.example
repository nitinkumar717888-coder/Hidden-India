# ==============================================================================
# HIDDEN INDIA — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# DO NOT COMMIT SECRETS OR REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Hidden India"
NEXT_PUBLIC_APP_TAGLINE="Discover the India you weren't told about"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (PostgreSQL / Supabase / Neon / Local PG)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hidden_india"
# Direct URL for running database migrations if connection pooling (PgBouncer) is active
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hidden_india"

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION & CLIENT
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# Service role key with admin privileges (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 4. GOOGLE MAPS PLATFORM (OPTIONAL FOR PRODUCTION ROUTING & GEOCODING)
# ------------------------------------------------------------------------------
# If omitted or empty, the application falls back gracefully to local
# Haversine distance calculations and OpenStreetMap directions.
# Client-side Google Maps key (restricted by HTTP Referrer in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server-side Google Maps key (restricted by IP for backend Routes API & Geocoding)
GOOGLE_MAPS_SERVER_KEY=""

# ------------------------------------------------------------------------------
# 5. CONTENT & EDITORIAL SETTINGS
# ------------------------------------------------------------------------------
# Require source verification before a destination is visible in public searches
REQUIRE_SOURCE_VERIFICATION=true
# Default fuel price cache duration in seconds (e.g., 86400 = 24 hours)
FUEL_PRICE_CACHE_TTL=86400

# ------------------------------------------------------------------------------
# 6. PRIVACY & ANALYTICS (OPTIONAL, PRIVACY-PRESERVING)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
